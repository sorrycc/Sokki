{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go tool mygo vet:*)",
      "Bash(go tool mygo build:*)",
      "Bash(go mod tidy)",
      "Bash(gofmt:*)",
      "Bash(scripts/dev.sh)",
      "Bash(scripts/release-notes.sh:*)",
      "Bash(cat mygo.json)",
      "Bash(cat CHANGELOG.md)",
      "Bash(cat go.mod)",
      "Bash(ls:*)",
      "Bash(du:*)",
      "Bash(file:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(codesign -dv:*)",
      "Bash(codesign --verify:*)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(cat .env)",
      "Bash(scripts/bump.sh patch)",
      "Bash(scripts/bump.sh minor)",
      "Bash(scripts/bump.sh major)",
      "Bash(rm -rf:*)"
    ]
  }
}
