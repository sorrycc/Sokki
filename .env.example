# R2 credentials for publishing releases. Do NOT commit the real .env — it's gitignored.
# Bun auto-loads from the current working directory; release.ts cd's to the project root,
# so this file MUST live at repo root (not under Scripts/).

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=downloads
APP_KEY_PREFIX=sokki
